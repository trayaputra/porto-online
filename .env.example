# 🔑 SUPABASE CONFIGURATION
# Get these from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# ⚙️ SERVER-SIDE ONLY (NEVER COMMIT TO GIT)
# Required for Admin Dashboard, Realtime Subscriptions, and Server Actions
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# 🌐 DEPLOYMENT & SEO
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# 👮 ADMIN ACCESS CONTROL
# Comma-separated list of emails allowed to access /admin
ADMIN_EMAILS="admin@youremail.com"

# 📊 OPTIONAL: Analytics or Third-party Keys (if added later)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# 💡 TIPS:
# - Rename this file to ".env" locally before running "npm run dev"
# - Never commit ".env" to GitHub — it's in .gitignore by default
# - On Vercel: add these as Environment Variables in Project Settings